# KAVACH Safety Platform Environment Configuration

# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=kavach_super_secret_jwt_key_change_in_production_2026_agentic
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./data/kavach.db

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Google Gemini API
# If left blank or GEMINI_API_KEY is not set, system automatically falls back
# to deterministic reasoning engine for seamless hackathon judge evaluation.
GEMINI_API_KEY=

# Safety & Proximity Thresholds
PROXIMITY_WARNING_DISTANCE_METERS=150.0
HIGH_RISK_DISTANCE_METERS=80.0
CORROBORATION_THRESHOLD=3
MATCH_SIMILARITY_THRESHOLD=0.65
GPS_SIMULATION_INTERVAL_MS=1200

# Default Seed Authority Credentials (fictional demo credentials)
AUTHORITY_DEMO_EMAIL=inspector.patnaik@odishapolice.gov.in
AUTHORITY_DEMO_PASSWORD=KavachShield@2026
